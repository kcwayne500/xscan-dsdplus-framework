{
  "id": "/xscan-mobile",
  "name": "XScan Radio Console",
  "short_name": "XScan",
  "description": "DSDPlus scanner control, live audio, and call history",
  "start_url": "/#dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#071119",
  "theme_color": "#071119",
  "categories": ["utilities", "music"],
  "icons": [
    {"src":"/icons/xscan-192.png","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"/icons/xscan-maskable-192.png","sizes":"192x192","type":"image/png","purpose":"maskable"},
    {"src":"/icons/xscan-512.png","sizes":"512x512","type":"image/png","purpose":"any"},
    {"src":"/icons/xscan-maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}
  ],
  "shortcuts": [
    {"name":"Listen Live","short_name":"Live","url":"/#dashboard","icons":[{"src":"/icons/xscan-192.png","sizes":"192x192"}]},
    {"name":"Recorded Calls","short_name":"Calls","url":"/#calls","icons":[{"src":"/icons/xscan-192.png","sizes":"192x192"}]}
  ]
}
